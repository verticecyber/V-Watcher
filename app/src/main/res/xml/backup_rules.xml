<?xml version="1.0" encoding="utf-8"?>
<!-- V-Watcher backup rules (API 23-30 full backup).
     App holds NO persistent user state (RAM-only immune memory, no Room/prefs/files).
     Explicit excludes document the stateless posture; re-observe on restore. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
