<?xml version="1.0" encoding="utf-8"?>
<!-- V-Watcher data extraction rules (API 31+ cloud backup + device transfer).
     Stateless by design: nothing to back up, everything reconstructible via re-observation.
     See docs/PRIVACY_DATA_MAP.md and docs/RELEASE_READINESS.md (Doze/backup). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
